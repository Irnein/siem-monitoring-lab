#!/usr/bin/env python3
import sys, json, urllib.request, urllib.parse

alert_file = sys.argv[1]
hook_url = sys.argv[3]

with open(alert_file) as f:
    alert = json.load(f)

rule = alert.get("rule", {})
agent = alert.get("agent", {})
text = (
    "Wazuh alert\n"
    f"Level {rule.get('level')}: {rule.get('description')}\n"
    f"Rule ID: {rule.get('id')}\n"
    f"Agent: {agent.get('name')} ({agent.get('ip', 'n/a')})\n"
    f"Time: {alert.get('timestamp')}\n"
    f"Log: {alert.get('full_log', '')[:300]}"
)

data = urllib.parse.urlencode({"text": text}).encode()
urllib.request.urlopen(urllib.request.Request(hook_url, data=data), timeout=10)
